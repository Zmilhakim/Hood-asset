# Copy to .env.local and fill in. Every one of these is optional except the
# factory address — without it the site runs and honestly reports that the
# board has not opened yet.

# The deployed HoodpadFactory. Printed by `npm run deploy` in ../contracts.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Robinhood Chain RPC. Defaults to a public endpoint; use your own for anything
# with traffic. Verify against docs.robinhood.com/chain/connecting.
NEXT_PUBLIC_RPC_URL=

# Block explorer used for the "↗" links.
NEXT_PUBLIC_EXPLORER_URL=
