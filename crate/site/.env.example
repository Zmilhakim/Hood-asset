# Copy to .env.local and fill in. Every one of these is optional, and on the
# real deployment all of them are empty: the crate is packed, so the addresses
# are written into src/lib/addresses.ts and the page is right without any of
# this. These override them — for a fork, a test chain, or a local experiment.

# The CrateToken, printed by `npm run pack` in ../contracts.
# `none` renders the pre-launch page instead, which is the only way to get it.
NEXT_PUBLIC_TOKEN_ADDRESS=

# The CrateRouter, printed by `npm run deploy-router`.
NEXT_PUBLIC_ROUTER_ADDRESS=

# The CratePacker, so the page can read the seal and the pool from one place.
NEXT_PUBLIC_PACKER_ADDRESS=

# Robinhood Chain RPC. Defaults to a public endpoint; use your own for traffic.
NEXT_PUBLIC_RPC_URL=

# Block explorer used for the "↗" links.
NEXT_PUBLIC_EXPLORER_URL=

# The site's own address, for OG tags. Vercel supplies one at build time.
NEXT_PUBLIC_SITE_URL=
